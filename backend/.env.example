# Copy to .env and fill in. .env is gitignored - never commit real values.
FLASK_CONFIG=development
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32
DATABASE_URL=sqlite:///caresphere-dev.db
FRONTEND_ORIGINS=http://127.0.0.1:5500

# SSLCommerz sandbox credentials
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Where SSLCommerz sends the patient back after paying, and where it posts
# its IPN. On localhost the redirect works but IPN cannot reach you; point
# this at a tunnel (ngrok etc.) to exercise IPN. See docs/PAYMENTS.md.
PUBLIC_BASE_URL=http://127.0.0.1:5000

# OpenRouter key for the two-stage AI health assistant.
# Without it the assistant still runs: the emergency rules work exactly the
# same and the reasoning falls back to a conservative general recommendation,
# clearly labelled "Limited mode" in the UI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_TIMEOUT=40
